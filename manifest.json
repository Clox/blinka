{
  "manifest_version": 3,
  "name": "Blinka",
  "version": "0.12.0",
  "description": "Flikgruppssignal när ChatGPT slutar styra en grupperad flik utom synhåll.",
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Blinka", "default_popup": "popup.html"}
}
