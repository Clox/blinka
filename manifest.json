{
  "manifest_version": 3,
  "name": "Blinka",
  "version": "0.16.0",
  "description": "Flikgruppssignal för ChatGPTs sidopanel och vanliga ChatGPT-flikar.",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "scripting"],
  "optional_host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Blinka", "default_popup": "popup.html"}
}
