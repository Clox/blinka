[Unit]
Description=Blinka signal server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/oscar/projects/blinka/signal-probe
Environment=BLINKA_STATE_FILE=/home/oscar/.local/state/blinka/pairs.json
ExecStart=/home/oscar/.nvm/versions/node/v22.21.1/bin/node /home/oscar/projects/blinka/signal-probe/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
