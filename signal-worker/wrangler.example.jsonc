{
  "name": "blinka-signal",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blinka-signal",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "PAIR_RATE",
      "namespace_id": "51730",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
